{
  "title": "2bot — Errors & Rate Limits",
  "uid": "2bot-errors",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["2bot", "platform"],
  "timezone": "browser",
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "5xx by route (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "topk(10, sum by (route) (rate(bot_http_requests_total{status=~\"5..\"}[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "401 / 403 (auth failures, req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum (rate(bot_http_requests_total{status=\"401\"}[$__rate_interval]))", "legendFormat": "401" },
        { "expr": "sum (rate(bot_http_requests_total{status=\"403\"}[$__rate_interval]))", "legendFormat": "403" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Rate-limit rejections by route + scope",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (route, scope) (rate(bot_rate_limit_rejections_total[$__rate_interval]))",
          "legendFormat": "{{route}} ({{scope}})"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Sensitive-route fail-closed events (last 1h)",
      "description": "Wave 1.3 — auth/billing/webhooks refused service while Redis was degraded.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(bot_rate_limit_rejections_total{scope=\"sensitive-fail-closed\"}[1h]))"
        }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ {"color":"green","value":null}, {"color":"yellow","value":1}, {"color":"red","value":50} ] } } },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Circuit breaker state",
      "description": "0=closed, 1=half-open, 2=open. Anything > 0 means the rate limiter is in a degraded mode.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "max(bot_circuit_breaker_state)" }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ {"color":"green","value":null}, {"color":"yellow","value":1}, {"color":"red","value":2} ] } } },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 }
    }
  ]
}
