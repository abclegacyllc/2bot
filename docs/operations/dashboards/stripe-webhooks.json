{
  "title": "2bot — Stripe Webhooks",
  "uid": "2bot-stripe",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["2bot", "billing", "stripe"],
  "timezone": "browser",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Webhook request rate by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(bot_http_requests_total{route=~\".*/webhooks/stripe\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Webhook latency p95 (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bot_http_request_duration_ms_bucket{route=~\".*/webhooks/stripe\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Webhook 4xx in last 1h",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(bot_http_requests_total{route=~\".*/webhooks/stripe\",status=~\"4..\"}[1h]))"
        }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ {"color":"green","value":null}, {"color":"yellow","value":1}, {"color":"red","value":10} ] } } },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Webhook 5xx in last 1h",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(bot_http_requests_total{route=~\".*/webhooks/stripe\",status=~\"5..\"}[1h]))"
        }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ {"color":"green","value":null}, {"color":"red","value":1} ] } } },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 }
    }
  ]
}
